  "data_files": {
    "yarn_demand": "cfab_Yarn_Demand_By_Style.csv",
    "sales_orders": "eFab_SO_List.csv",
    "style_bom": "Style_BOM.csv",
    "inventory": "Inventory.csv",
    "suppliers": "Supplier_ID.csv",
